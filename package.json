{
  "name": "syucai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "wrangler dev",
    "db:local": "wrangler d1 migrations apply syucai --local",
    "db:remote": "wrangler d1 migrations apply syucai --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.2.2",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
