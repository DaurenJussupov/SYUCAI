{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syucai",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syucai",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "syucai-files"
    }
  ],
  "observability": {
    "enabled": true
  },
  "account_id": "58b81705726a643c19d8d5b251be8e11",
  "build": {
    "command": "npm run build && node scripts/cloudflare-resources.js"
  },
  "workers_dev": true
}
